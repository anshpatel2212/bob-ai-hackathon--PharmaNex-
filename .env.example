# ==============================================================================
# PharmaGuard AI — Environment Configuration Template
# ==============================================================================

# Environment Mode: 'development' or 'production'
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Render)
# ------------------------------------------------------------------------------
# Production (Render PostgreSQL): postgresql://user:password@host/dbname
# Local Fallback (SQLite): sqlite:///./pharmaguard.db
DATABASE_URL=postgresql://pharmaguard:pharmaguard_secret@localhost:5432/pharmaguard_db

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# Generate a random 64-character secret in production using: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_hex_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# CORS & Cookie Security
# ------------------------------------------------------------------------------
# URL of the deployed frontend on Render
FRONTEND_URL=https://bob-ai-hackathon-pharmanex.onrender.com
# In production on Render: COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# For local development:
VITE_API_URL=http://localhost:8000
# For production deployment on Render (set in Render frontend service env vars):
# VITE_API_URL=https://YOUR-BACKEND.onrender.com
# IMPORTANT: Do NOT append /api because src/services/api.ts already appends /api

# ------------------------------------------------------------------------------
# Storage Provider Configuration (Optional)
# ------------------------------------------------------------------------------
# STORAGE_BACKEND: 'local' (development) or 's3' (production object storage)
STORAGE_BACKEND=local
# S3_BUCKET_NAME=pharmaguard-documents
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
