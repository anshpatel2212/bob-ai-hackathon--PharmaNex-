# PharmaGuard AI Environment Configuration

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local SQLite fallback when testing without Postgres: sqlite:///./pharmaguard.db
DATABASE_URL=postgresql://pharmaguard:pharmaguard_secret@localhost:5432/pharmaguard_db

# Security & JWT Configuration
JWT_SECRET=super_secret_pharmaguard_jwt_key_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & Cookie Security
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
